    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mysql": "^2.15.27",
    "@types/node": "^25.7.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0"
  }
