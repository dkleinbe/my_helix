{
    "compilerOptions": {
        
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "nodenext",
        "rootDir": "./src",
        "outDir": "./build",
        "moduleResolution": "nodenext",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2018",
        "paths": {
          "@/*": ["./*"]
        }
    },
    "include": ["src"],
}
