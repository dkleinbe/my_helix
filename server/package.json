    "url": "https://xavier2p.fr"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@logtape/express": "^2.2.4",
    "@logtape/logtape": "^2.2.4",
    "@logtape/pretty": "^2.2.4",
    "@logto/express": "^3.0.15",
    "ajv": "^8.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mysql": "^2.18.1",
    "typescript": "^6.0.3"
  },
