{
  "name": "server",
  "version": "2.0.0",
  "type": "module",
  "description": "The server part of the Helix Project",
  "main": "server.ts",
  "private": true,
  "scripts": {
    "build": "npx tsc",
    "rebuild": "npx tsc --build --force",
    "start": "node build/server.js",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q build/server.js\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy_data": "mkdir -p build/data/database/migrations && cp database/scripts/*.sql build/data/database/migrations",
    "clean": "rm -rf build"
  },
  "author": {
    "name": "Xavier2p",
